{
  "name": "mtg-suite",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:debug": "vitest --inspect-brk=127.0.0.1:9229 --no-file-parallelism --test-timeout=0 --hook-timeout=0",
    "check:theme": "node scripts/check-theme.js",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:theme && pnpm check:unused && pnpm test",
    "build": "pnpm -r --if-present build",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "prepare": "husky",
    "dev": "pnpm --recursive --parallel run dev",
    "dev:debug": "pnpm --recursive --parallel run dev:debug",
    "import:catalog": "pnpm --filter @mtg-suite/api run import:catalog",
    "import:daily": "pnpm --filter @mtg-suite/api run import:daily",
    "import:debug": "pnpm --filter @mtg-suite/api run import:debug",
    "sheet:preview": "pnpm --filter @mtg-suite/api run sheet:preview",
    "landing:screenshots": "node scripts/landing-screenshots.js",
    "check:phone-width": "node scripts/check-phone-width.js",
    "web:preview": "node scripts/web-preview.js",
    "check:unused": "knip --no-progress",
    "check:staging": "node scripts/check-staging.js",
    "deps:outdated": "node scripts/deps-outdated.js"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,md,yaml,yml,css,html}": "prettier --check"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "6.45.1",
    "lint-staged": "^17.6.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}

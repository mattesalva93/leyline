{
  "name": "protect-main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main", "refs/heads/spec/**"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["merge"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          { "context": "check", "integration_id": 15368 },
          { "context": "workflows", "integration_id": 15368 },
          { "context": "secrets", "integration_id": 15368 },
          { "context": "dependencies", "integration_id": 15368 },
          { "context": "images", "integration_id": 15368 },
          { "context": "release-entry", "integration_id": 15368 },
          { "context": "spec-release-readme", "integration_id": 15368 }
        ]
      }
    },
    { "type": "non_fast_forward" }
  ]
}

# Serves the built `web` app and forwards /api to the `api` service, over HTTPS (ADR 0011).
{
	# The local CA cannot be installed into the host's trust store from inside a container.
	skip_install_trust
}

# Forwards an error report to the Bugsink project's envelope endpoint without anything that
# names its sender: its address, its cookies, its credential, its browser (ADR 0027). Off while
# the host's `.env` names no Bugsink, or no project of it. `pnpm check:staging` pins all of it.
(forward-error-reports) {
	@errorReportingOff expression `"{$BUGSINK_ORIGIN}" == "" || "{$BUGSINK_PROJECT_ID}" == ""`
	respond @errorReportingOff 404
	request_body {
		max_size 1MB
	}
	rewrite * /api/{$BUGSINK_PROJECT_ID}/envelope/
	reverse_proxy {$BUGSINK_ORIGIN} {
		header_up Host {upstream_hostport}
		header_up -Cookie
		header_up -Authorization
		header_up -User-Agent
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
		header_up -X-Real-IP
		header_up -Forwarded
		header_up -Via
		header_down -Set-Cookie
	}
}

{$SITE_ADDRESS} {
	# The security baseline (ADR 0016), on the page and on /api alike; `pnpm check:staging` pins it.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Every browser feature the app does not use is off; the PDF goes to the share sheet.
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), web-share=(self)"
		Cross-Origin-Opener-Policy same-origin
		# Inline styles only, never inline scripts (ADR 0016).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://cards.scryfall.io; connect-src 'self' https://cards.scryfall.io; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}

	# The access log keeps the least personal data (ADR 0016): the client's network, never its
	# address, and no request headers, where a client or a proxy can write an address of its own.
	# Rotated and deleted by age; `pnpm check:staging` pins the retention.
	log {
		output file /var/log/caddy/access.log {
			roll_interval 24h
			roll_keep_for 14d
			# Caddy also caps how many files it keeps, 10 by default, which would delete them
			# before 14 days: room for every day, and for the files a size roll adds.
			roll_keep 30
		}
		format filter {
			request>remote_ip ip_mask 24 64
			request>client_ip ip_mask 24 64
			request>headers delete
		}
	}

	# The testers' guard, the emergency switch of the open alpha (ADR 0023): on the page and on
	# /api alike while `scripts/tester-guard.sh` has written it, open while the folder holds none.
	# A glob that matches no file only warns, where a missing file would stop Caddy.
	import /etc/caddy/tester-guard/*.caddy

	handle /api/* {
		reverse_proxy api:3000
	}

	# The browser's error reports (ADR 0027), at the path `web`'s error reporting module sends
	# them to. Under the testers' guard, like the rest of the site.
	handle /error-reports {
		import forward-error-reports
	}

	# The browser's product events (ADR 0027), at the path `web`'s product events module sends them
	# to, and the one path of Umami the site reaches: its dashboard and other APIs stay behind the
	# SSH tunnel (docs/deploy.md). Umami gets no address of the client, so it hashes none into a
	# session and locates nobody, nor its cookies or credential; the browser keeps the site's own
	# headers, not Umami's. Under the testers' guard, like the rest of the site. `pnpm
	# check:staging` pins all of it.
	handle /product-events {
		@notAnEvent not method POST
		respond @notAnEvent 405
		request_body {
			max_size 64KB
		}
		rewrite * /api/send
		reverse_proxy umami:3000 {
			header_up -Cookie
			header_up -Authorization
			# Every header Umami reads an address from (`scripts/staging-checks/product-events.js`).
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded
			header_up -Forwarded
			header_up -X-Real-IP
			header_up -True-Client-IP
			header_up -CF-Connecting-IP
			header_up -Fastly-Client-IP
			header_up -X-NF-Client-Connection-IP
			header_up -DO-Connecting-IP
			header_up -X-AppEngine-User-IP
			header_up -X-Client-IP
			header_up -X-Cluster-Client-IP
			header_up -Via
			header_down -Set-Cookie
			header_down -Content-Security-Policy
			header_down -Access-Control-*
			header_down -X-Powered-By
			header_down -X-DNS-Prefetch-Control
		}
	}

	# Cache (ADR 0025): a page left open must learn of a new release, and reloading must bring
	# it, while assets named after their content's hash never change. `pnpm check:staging` pins
	# the three. A missing asset answers 404, uncached, rather than the page under its name.
	handle /assets/* {
		root * /srv
		@hashedAsset file
		header @hashedAsset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /version.json {
		root * /srv
		header Cache-Control no-store
		file_server
	}

	handle {
		root * /srv
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}

# The `www.` name, with a certificate of its own, sends every visitor to the site: a link with
# `www.` still lands on the alpha, while the site keeps one address. HSTS needs no header here:
# the site's `includeSubDomains` already covers this name.
www.{$SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

# For the compose healthcheck only, never published: plain HTTP, because the public site's
# certificate names its domain, which a request from inside the container cannot match. Outside
# the testers' guard, so the healthcheck needs no credential and the deploy stays automatic
# whether the guard is on or off.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	root * /srv
	file_server
}

# The api's error reports (ADR 0027). The api has no route out of Docker (ADR 0016): it sends them
# here, over the `proxy` network, and Caddy forwards them as it does the browser's. Never
# published, as Compose publishes 80 and 443 alone, and `pnpm check:staging` pins that the
# public site does not reach it. Every service on the `internet` network reaches it too, the
# importer among them: that gains it nothing, as it can reach Bugsink straight, and the DSN is
# public in the web bundle. Outside the testers' guard: the api has no credential.
http://:8082 {
	handle /error-reports {
		import forward-error-reports
	}
	handle {
		respond 404
	}
}

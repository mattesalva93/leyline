# Serves the built `web` app and forwards /api to the `api` service, over HTTPS (ADR 0011).
{
	# The local CA cannot be installed into the host's trust store from inside a container.
	skip_install_trust
}

{$SITE_ADDRESS} {
	# Not for search engines yet (also <meta name="robots"> in index.html).
	header X-Robots-Tag "noindex, nofollow"

	# The security baseline (ADR 0016), on the page and on /api alike; `pnpm check:staging` pins it.
	header {
		# No `preload` while the domain may still change.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		# Card images come from Scryfall, which needs not learn the page that asked for them.
		Referrer-Policy no-referrer
		# Every browser feature the app does not use is off; the PDF goes to the share sheet.
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), web-share=(self)"
		Cross-Origin-Opener-Policy same-origin
		# No Cross-Origin-Embedder-Policy: Scryfall's images send no Cross-Origin-Resource-Policy.
		Content-Security-Policy "frame-ancestors 'none'"
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# For the compose healthcheck only, never published: plain HTTP, because the public site's
# certificate names its domain, which a request from inside the container cannot match.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	root * /srv
	file_server
}

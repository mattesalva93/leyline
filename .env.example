# Production: strong passwords, set before the first start (docs/deploy.md).
# The superuser, which only initialises the database.
POSTGRES_USER=leyline
POSTGRES_PASSWORD=leyline
POSTGRES_DB=leyline
POSTGRES_PORT=5432
# The roles docker/postgres/init creates: the importer's, owning the schema, and the api's, reading.
LEYLINE_OWNER_PASSWORD=leyline_owner
LEYLINE_READER_PASSWORD=leyline_reader
# Umami's role, which owns its own database apart from the catalog (docker/postgres/init), and the
# secret Umami signs its logins and hashes its sessions with (ADR 0027).
UMAMI_DATABASE_PASSWORD=umami
UMAMI_APP_SECRET=umami-app-secret
# The id of the site in Umami's dashboard, built into the web bundle, which records product
# events only with it (ADR 0027): off while empty (docs/deploy.md).
VITE_UMAMI_WEBSITE_ID=
# `pnpm import:catalog` and `pnpm dev`'s api connect with these; they match the values above.
OWNER_DATABASE_URL=postgres://leyline_owner:leyline_owner@localhost:5432/leyline
READER_DATABASE_URL=postgres://leyline_reader:leyline_reader@localhost:5432/leyline
# Where Caddy answers (ADR 0011). Production: the public domain.
SITE_ADDRESS=localhost
# The host interface Docker publishes Caddy's ports on. Production: 0.0.0.0.
PUBLISH_ADDRESS=127.0.0.1
# Error reporting to Bugsink (ADR 0027), off while empty. The project's DSN, built into the web
# bundle and handed to the api, and where Caddy forwards the reports: the DSN's scheme and host,
# and its project number.
VITE_BUGSINK_DSN=
BUGSINK_ORIGIN=
BUGSINK_PROJECT_ID=
# The importer's check-in to Healthchecks.io (ADR 0027), off while empty: the check's ping URL
# (docs/deploy.md).
HEALTHCHECKS_PING_URL=
# The credential `pnpm check:staging --access closed` signs in with, a line of its own among the
# testers' (docs/staging.md). `--access open` needs none.
CHECK_STAGING_USERNAME=
CHECK_STAGING_PASSWORD=

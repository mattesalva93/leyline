# Production: a strong password, set before the first start (docs/deploy.md).
POSTGRES_USER=mtg
POSTGRES_PASSWORD=mtg
POSTGRES_DB=mtg_suite
POSTGRES_PORT=5432
# Used by the api and the import; matches the values above.
DATABASE_URL=postgres://mtg:mtg@localhost:5432/mtg_suite
# Where Caddy answers (ADR 0011). Production: the public domain, and LISTEN_ADDRESS=0.0.0.0.
SITE_ADDRESS=localhost
LISTEN_ADDRESS=127.0.0.1

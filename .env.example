# Production: a strong password, set before the first start (docs/deploy.md).
POSTGRES_USER=mtg
POSTGRES_PASSWORD=mtg
POSTGRES_DB=mtg_suite
POSTGRES_PORT=5432
# Used by the api and the import; matches the values above.
DATABASE_URL=postgres://mtg:mtg@localhost:5432/mtg_suite
# Where Caddy answers (ADR 0011). Production: the public domain.
SITE_ADDRESS=localhost
# The host interface Docker publishes Caddy's ports on. Production: 0.0.0.0.
PUBLISH_ADDRESS=127.0.0.1
# The credential `pnpm check:staging` signs in with, a line of its own among the testers'
# (docs/staging.md).
CHECK_STAGING_USERNAME=
CHECK_STAGING_PASSWORD=

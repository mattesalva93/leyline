# Production: strong passwords, set before the first start (docs/deploy.md).
# The superuser, which only initialises the database.
POSTGRES_USER=mtg
POSTGRES_PASSWORD=mtg
POSTGRES_DB=mtg_suite
POSTGRES_PORT=5432
# The roles docker/postgres/init creates: the importer's, owning the schema, and the api's, reading.
MTG_OWNER_PASSWORD=mtg_owner
MTG_READER_PASSWORD=mtg_reader
# `pnpm import:catalog` and `pnpm dev`'s api connect with these; they match the values above.
OWNER_DATABASE_URL=postgres://mtg_owner:mtg_owner@localhost:5432/mtg_suite
READER_DATABASE_URL=postgres://mtg_reader:mtg_reader@localhost:5432/mtg_suite
# Where Caddy answers (ADR 0011). Production: the public domain.
SITE_ADDRESS=localhost
# The host interface Docker publishes Caddy's ports on. Production: 0.0.0.0.
PUBLISH_ADDRESS=127.0.0.1
# The credential `pnpm check:staging` signs in with, a line of its own among the testers'
# (docs/staging.md).
CHECK_STAGING_USERNAME=
CHECK_STAGING_PASSWORD=
